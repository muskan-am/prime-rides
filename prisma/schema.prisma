generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingSource {
  ONLINE
  PHONE
  WHATSAPP
  WALK_IN
  ADMIN
}

enum VehicleAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

enum VehicleMaintenanceStatus {
  GOOD
  MAINTENANCE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}



enum EnquiryStatus {
  NEW
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum PackageType {
  WEEKLY
  MONTHLY
  YEARLY
}




model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  mobile    String?
  role      String   @default("CUSTOMER")

  teamMember       TeamMember?
  customerProfile  CustomerProfile?

  bookings         Booking[]
  createdBookings  Booking[] @relation("BookingCreatedBy")
  couponUsages     CouponUsage[]
  reviews          Review[]
  notifications    Notification[]
  notificationPreference NotificationPreference?
  enquiries        Enquiry[]
  enquiryFollowUps EnquiryFollowUp[]
  auditLogs        AuditLog[]
  emailLogs        EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?

  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model TeamMember {
  id     String @id @default(cuid())
  userId String @unique

  designation String?
  isActive    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique

  address    String?
  city       String?
  state      String?
  postalCode String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  latitude  Decimal?
  longitude Decimal?
  isActive  Boolean  @default(true)

  deliveryCharges DeliveryCharge[]
  inventory       Inventory[]
  bookings        Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Vehicle {
  id String @id @default(cuid())

  brand                String
  model                String
  variant              String?
  registrationNumber   String? @unique
  fuelType             String?
  transmission         String?
  seatingCapacity      Int?
  hasAirConditioning   Boolean @default(true)

  basePrice            Decimal
  deposit              Decimal @default(0)
  speedLimit           Int?
  rentalTerms          String?

  availabilityStatus   VehicleAvailabilityStatus @default(AVAILABLE)
  maintenanceStatus    VehicleMaintenanceStatus @default(GOOD)
  searchPriority       Int      @default(0)

  primaryImage         String?

  images               VehicleImage[]
  features             VehicleFeature[]
  specifications       VehicleSpecification[]
  rentalPackages       RentalPackage[]
  monthlyPlans         MonthlyPlan[]
  packages             Package[]
  bookings             Booking[]
  reviews              Review[]
  enquiries            Enquiry[]
  inventory            Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model VehicleImage {
  id        String @id @default(cuid())
  vehicleId String

  url       String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model VehicleFeature {
  id        String @id @default(cuid())
  vehicleId String

  name String

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model VehicleSpecification {
  id        String @id @default(cuid())
  vehicleId String

  name  String
  value String

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}


model RentalPackage {
  id        String @id @default(cuid())
  vehicleId String

  name        String
  description String?
  duration    Int
  price       Decimal
  isActive    Boolean @default(true)

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlyPlan {
  id        String @id @default(cuid())
  vehicleId String

  name      String
  months    Int
  price     Decimal
  isActive  Boolean @default(true)

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  type             PackageType
  shortDescription String?
  description      String?
  duration         Int
  price            Decimal
  image            String?
  features         String[]
  terms            String?
  isActive         Boolean     @default(true)
  sortOrder        Int         @default(0)

  vehicles         Vehicle[]
  bookings         Booking[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model TaxConfiguration {
  id       String  @id @default(cuid())
  name     String
  rate     Decimal
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryCharge {
  id         String  @id @default(cuid())
  locationId String

  charge    Decimal
  isActive  Boolean @default(true)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PickupOption {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Inventory {
  id         String @id @default(cuid())
  vehicleId  String
  locationId String

  quantity   Int     @default(1)
  isActive   Boolean @default(true)

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, locationId])
}


model Booking {
  id String @id @default(cuid())

  userId    String
  vehicleId String

  rentalPackageId String?
  monthlyPlanId   String?
  packageId       String?
  pickupOptionId  String?

  locationId String

  startDate DateTime
  endDate   DateTime

  status BookingStatus @default(PENDING)
  bookingSource BookingSource @default(ONLINE)
  createdById   String?

  rentalAmount   Decimal
  deliveryCharge Decimal @default(0)
  taxAmount      Decimal @default(0)
  discountAmount Decimal @default(0)
  totalAmount    Decimal

  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentStatus     PaymentStatus @default(PENDING)
  paidAt            DateTime?

  user          User           @relation(fields: [userId], references: [id])
  createdBy     User?          @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  rentalPackage RentalPackage? @relation(fields: [rentalPackageId], references: [id])
  monthlyPlan   MonthlyPlan?   @relation(fields: [monthlyPlanId], references: [id])
  package       Package?       @relation(fields: [packageId], references: [id])
  pickupOption  PickupOption?  @relation(fields: [pickupOptionId], references: [id])
  location      Location       @relation(fields: [locationId], references: [id])

  couponUsage CouponUsage?
  payment     Payment?
  review      Review?
  emailLogs   EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique

  title           String?
  description     String?

  discountType    DiscountType
  discountValue   Decimal

  minBookingValue Decimal?
  maxDiscount     Decimal?

  validFrom       DateTime
  validUntil      DateTime

  usageLimit      Int?
  isActive        Boolean      @default(true)

  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponUsage {
  id String @id @default(cuid())

  couponId String
  userId   String
  bookingId String @unique

  discountAmount Decimal

  coupon  Coupon  @relation(fields: [couponId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  usedAt DateTime @default(now())
}


model Payment {
  id String @id @default(cuid())

  bookingId String @unique

  amount Decimal
  status PaymentStatus @default(PENDING)

  transactionId String? @unique
  gateway       String?

  booking Booking @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Refund {
  id String @id @default(cuid())

  paymentId String
  amount    Decimal
  status    RefundStatus @default(PENDING)

  refundId String? @unique
  reason   String?

  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id String @id @default(cuid())

  userId    String
  vehicleId String
  bookingId String @unique

  rating  Int
  comment String?

  user    User    @relation(fields: [userId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  message   String

  link      String?

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingCreated       Boolean @default(true)
  paymentPending       Boolean @default(true)
  paymentSuccess       Boolean @default(true)
  bookingConfirmed     Boolean @default(true)
  bookingCancelled     Boolean @default(true)
  bookingCompleted     Boolean @default(true)

  adminNewBooking      Boolean @default(true)
  adminPaymentReceived Boolean @default(true)
  adminBookingCancelled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Enquiry {
  id String @id @default(cuid())

  name      String?
  mobile    String?
  email     String?

  userId    String?
  vehicleId String?

  subject   String?
  message   String
  status    EnquiryStatus @default(NEW)

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  followUps EnquiryFollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model EnquiryFollowUp {
  id String @id @default(cuid())

  enquiryId String
  userId    String?

  note          String
  followUpAt    DateTime?
  isCompleted   Boolean @default(false)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  userId   String?
  action   AuditAction
  entity   String
  entityId String?
  details  String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformStat {
  id          String   @id @default(cuid())
  label       String
  valueNumber Float
  prefix      String   @default("")
  suffix      String   @default("+")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExploringCity {
  id            String   @id @default(cuid())
  name          String
  subtitle      String?
  image         String
  locationQuery String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactSettings {
  id                String   @id @default("singleton")
  eyebrow           String   @default("WE'RE HERE TO HELP")
  heading           String   @default("Contact & Support")
  description       String   @default("Have a question about our cars, bookings or rental plans? Our team is here to help. Get in touch with us through any of the options below or send us a message.")
  phone             String   @default("+91 98765 43210")
  email             String   @default("support@primerides.com")
  locationsText     String   @default("Delhi · Goa · Bangalore")
  responseTimeText  String   @default("We usually respond within 24 hours")

  // Support Highlights
  highlight1Title   String   @default("Quick Support")
  highlight1Desc    String   @default("We respond fast")
  highlight1Icon    String   @default("Zap")

  highlight2Title   String   @default("Reliable Assistance")
  highlight2Desc    String   @default("Your travel partner")
  highlight2Icon    String   @default("ShieldCheck")

  highlight3Title   String   @default("Customer First")
  highlight3Desc    String   @default("Always here for you")
  highlight3Icon    String   @default("HeartHandshake")

  // Hero Content
  heroHeading       String   @default("Contact & Support")
  heroDescription   String   @default("Have a question about our cars, bookings or rental plans? Our team is here to help. Get in touch with us through any of the options below or send us a message.")
  heroImage         String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EmailLog {
  id                String   @id @default(cuid())

  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  bookingId         String?
  booking           Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  recipient         String
  type              String
  subject           String

  status            String   @default("PENDING")

  providerMessageId String?
  errorMessage      String?

  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([bookingId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}